{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Interview Agent",
  "version": "0.1.0",
  "identifier": "com.interviewagent.app",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "node scripts/start-dev.mjs",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Interview Agent",
        "width": 1440,
        "height": 1024,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
